# Public app URL; do not put secrets in NEXT_PUBLIC variables.
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose this key to browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary (server-side signing uses API secret)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Operations
CRON_SECRET=
LOG_LEVEL=info

# Payment provider credentials are intentionally not enabled in this scaffold.
# Add sandbox/live credentials only after provider product and callback requirements
# are verified. Keep all provider secrets server-side.