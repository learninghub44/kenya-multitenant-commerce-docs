# Public root-domain URL used for merchant wildcard subdomains; use the apex/root domain in production.
# Example production value: https://example.co.ke
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Subdomain storefronts: set both to your root domain in production (https://example.co.ke).
# Each store is then served at https://<store-slug>.example.co.ke. See docs/30-authentication.md
# and docs/31-store-subdomains.md for DNS and Cloudflare Worker route setup.

# Supabase project configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose this key to browser code.
SUPABASE_SERVICE_ROLE_KEY=
# Local Supabase CLI only (supabase start). Hosted projects configure Google in the dashboard.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Cloudinary (server-side signing uses API secret)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Operations
CRON_SECRET=
LOG_LEVEL=info

# Payment provider credentials are intentionally not enabled in this scaffold.
# Add sandbox/live credentials only after provider product and callback requirements
# are verified. Keep all provider secrets server-side.